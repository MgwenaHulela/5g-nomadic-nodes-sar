<?xml version="1.0"?>
<!--
  sar_burger — stock turtlebot3_burger + Gazebo Harmonic DiffDrive.

  The stock model's gazebo_ros_* plugins are Gazebo-Classic-only and fail
  to load on Harmonic, leaving the robot without any drive controller —
  which is why motion used to be set_pose teleports (wheels never spun).
  This wrapper merges the stock model and adds gz-sim's own DiffDrive.

  cmd_vel topic: left unset, so it defaults to /model/<name>/cmd_vel with
  <name> being whatever the world's <include><name> renames this model to
  (sar_ground_alpha -> /model/sar_ground_alpha/cmd_vel, etc.).

  Requires model://turtlebot3_burger and model://turtlebot3_common on
  GZ_SIM_RESOURCE_PATH (the TB3 workspace dirs).
-->
<sdf version="1.9">
  <model name="sar_burger">
    <include merge="true">
      <uri>model://turtlebot3_burger</uri>
    </include>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <max_linear_acceleration>5</max_linear_acceleration>
      <max_angular_acceleration>10</max_angular_acceleration>
    </plugin>

    <!-- Forward-facing SAR camera (the robot's POV). No explicit <topic>, so
         it auto-scopes to the per-robot model name the world assigns
         (sar_ground_alpha/bravo) — giving each robot its own image topic:
         /world/<world>/model/sar_ground_<r>/link/camera_link/sensor/cam_front/image
         Rendered by the world's Sensors system (ogre2). Streamed over 5G by
         stream_camera.sh via scripts/gz_camera_bridge.py. -->
    <link name="camera_link">
      <pose>0.03 0 0.17 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
      <sensor name="cam_front" type="camera">
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>250</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Thermal camera (victim detection by body heat). sar_-prefixed link
         to avoid clashing with the stock model. Auto-scoped topic:
         .../link/sar_thermal_link/sensor/thermal/image . Objects with a
         <temperature> show up hot; the world adds a warm "victim" marker. -->
    <link name="sar_thermal_link">
      <pose>0.03 0 0.17 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
      <sensor name="thermal" type="thermal">
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.05</near><far>250</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="sar_thermal_joint" type="fixed">
      <parent>base_link</parent>
      <child>sar_thermal_link</child>
    </joint>

    <!-- 2D lidar (mapping / obstacle sensing). gpu_lidar so it renders on
         Harmonic (the stock burger's Classic 'ray' sensor is inert here).
         sar_-prefixed to avoid clashing with the stock lidar_joint.
         Auto-scoped topic: .../link/sar_lidar_link/sensor/lidar/scan -->
    <link name="sar_lidar_link">
      <pose>-0.02 0 0.18 0 0 0</pose>
      <inertial><mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
    <joint name="sar_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>sar_lidar_link</child>
    </joint>
  </model>
</sdf>
