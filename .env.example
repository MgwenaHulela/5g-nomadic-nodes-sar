# Copy to .env and fill in, then:  export $(grep -v '^#' .env | xargs)
# .env is git-ignored — never commit your real password.
#
# Sudo password used by start_full_stack.sh, setup_over_air_test.sh,
# tune_throughput.sh, and auto_patrol.py (for netns/iperf inside namespaces).
# Alternatively, configure passwordless sudo and leave this unset.
SAR_SUDO_PASS=
