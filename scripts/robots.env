#!/usr/bin/env bash
# robots.env — single source of truth for the robot roster, shared by every
# shell script in the stack. Sourced, never executed.
#
#   source "$SELF_DIR/scripts/robots.env"
#
# Keep this in step with ROBOT_SPEC in scripts/auto_patrol.py and ROBOTS in
# channel_bridge.py. The Python side reads the same SAR_ROBOTS variable, so
# exporting it once configures the whole stack:
#
#   SAR_ROBOTS=alpha,bravo ./start_full_stack.sh     # published 2-robot setup
#   SAR_ROBOTS=alpha,bravo,charlie,delta ...         # default, 4 robots
#
# Per-robot fields, index-aligned with ROBOT_NAMES:
#   TUN      OAI interface. OAI names a UE's interface oaitun_ue1p<N> where N
#            is its PDU session index; each nrue_*.conf pads with N-1 dummy
#            sessions so its real "internet" session lands on a distinct
#            interface. That is how 4 UEs share one host.
#   NS       network namespace (downlink must cross the air, not loopback)
#   UE_IP    address assigned by the core from the 10.45.0.0/16 pool
#   TEST_IP  per-robot iperf3 server in the root namespace
#   CONF     OAI UE config
#   LOG      UE log file

SAR_ROBOTS="${SAR_ROBOTS:-alpha,bravo,charlie,delta}"
IFS=',' read -r -a ROBOT_NAMES <<< "$SAR_ROBOTS"

declare -A ROBOT_TUN=(
  [alpha]=oaitun_ue1    [bravo]=oaitun_ue1p2
  [charlie]=oaitun_ue1p3 [delta]=oaitun_ue1p4
)
declare -A ROBOT_NS=(
  [alpha]=robot_alpha   [bravo]=robot_bravo
  [charlie]=robot_charlie [delta]=robot_delta
)
declare -A ROBOT_UE_IP=(
  [alpha]=10.45.0.2     [bravo]=10.45.0.3
  [charlie]=10.45.0.4   [delta]=10.45.0.5
)
declare -A ROBOT_TEST_IP=(
  [alpha]=10.0.0.200    [bravo]=10.0.0.201
  [charlie]=10.0.0.202  [delta]=10.0.0.203
)
declare -A ROBOT_CONF=(
  [alpha]=nrue_alpha.conf     [bravo]=nrue_bravo.conf
  [charlie]=nrue_charlie.conf [delta]=nrue_delta.conf
)
declare -A ROBOT_LOG=(
  [alpha]=/tmp/ue_alpha.log     [bravo]=/tmp/ue_bravo.log
  [charlie]=/tmp/ue_charlie.log [delta]=/tmp/ue_delta.log
)
# Gazebo spawn positions, spread so robots do not stack on one point.
declare -A ROBOT_SPAWN=(
  [alpha]="15 0"   [bravo]="30 0"
  [charlie]="-10 15" [delta]="-25 -15"
)

ROBOT_COUNT=${#ROBOT_NAMES[@]}

for _r in "${ROBOT_NAMES[@]}"; do
  if [[ -z "${ROBOT_TUN[$_r]:-}" ]]; then
    echo "FATAL: unknown robot '$_r' in SAR_ROBOTS (known: ${!ROBOT_TUN[*]})" >&2
    return 1 2>/dev/null || exit 1
  fi
done
