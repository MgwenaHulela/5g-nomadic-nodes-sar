<?xml version="1.0"?>
<window>
  <width>1600</width>
  <height>900</height>
  <style
    material_theme="Dark"
    material_primary="Indigo"
    material_accent="LightBlue"
    toolbar_color_dark="#2d2d2d"
    toolbar_text_color_dark="#f3f3f3"
    plugin_toolbar_color_dark="#37474f"
    plugin_toolbar_text_color_dark="#eeeeee"
  />
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre</engine>
  <scene>scene</scene>
  <ambient_light>0.3 0.3 0.3</ambient_light>
  <background_color>0.2 0.2 0.2</background_color>
  <camera_pose>80 80 60 0 0.6 -2.3</camera_pose>
</plugin>

<!-- GzSceneManager is what actually populates the 3D view with entities
     from the running server (ground plane, robots, UAV). MinimalScene
     alone renders an empty black canvas — without this plugin the
     viewport stays blank with a waiting spinner. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Mouse orbit / pan / zoom in the 3D view -->
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>World control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">72</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>
</plugin>

<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <title>World stats</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">110</property>
    <property type="double" key="width">290</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>
</plugin>

<!-- Live metrics readout. NOTE: TopicEcho starts with its "Echo" switch
     OFF — flip the switch in the panel after the GUI opens to start the
     stream. (TopicViewer, used before, only lists topic names.) -->
<plugin filename="TopicEcho" name="Metrics">
  <gz-gui>
    <title>Metrics — flip Echo switch to start</title>
    <property type="string" key="state">docked</property>
    <property type="double" key="width">380</property>
    <property type="string" key="z">3</property>
  </gz-gui>
  <topic>/sar/metrics</topic>
</plugin>
