    <!-- Robots. UAV hovers OUTSIDE the building (south side) for a real
         O2I penetration path; the burgers spawn south of the entry door
         and drive IN through it to search room by room.
         Motion is cmd_vel/set_pose. -->
    <include>
      <name>sar_uav</name>
      <pose>0 -25 25 0 0 0</pose>
      <uri>model://x500_base</uri>
      <static>true</static>
    </include>

    <include>
      <name>sar_ground_alpha</name>
      <pose>0 -25 0 0 0 0</pose>
      <uri>model://sar_burger</uri>
    </include>

    <include>
      <name>sar_ground_bravo</name>
      <pose>0.8 -23 0 0 0 0</pose>
      <uri>model://sar_burger</uri>
    </include>

