<?xml version="1.0" ?>
<!--
  sar_open_field.sdf
  Open-field / rural terrain world for the AI-assisted 5G nomadic node testbed.

  Target: Gazebo Harmonic (gz-sim8), matches the version already in use
  (confirmed by gz.transport13 in channel_bridge.py).

  Deliberately uses ONLY built-in Gazebo Sim primitives and materials —
  no Fuel model URIs. This guarantees it loads with zero network
  dependency and zero risk of a broken/mistyped Fuel URI. Once this is
  confirmed working, realistic props (rubble, vehicles, trees) can be
  added from https://app.gazebosim.org/fuel/models by copying their
  <include><uri>...</uri></include> snippet directly from the site's
  "</>" button into the <world> element below — do this manually so the
  URI is guaranteed correct.

  World size: 500m x 500m, consistent with the field size used in the
  earlier Fortress-based project and large enough to comfortably contain
  the 15-150m A2G distances already validated in channel_bridge.py.
-->
<sdf version="1.9">
  <world name="sar_open_field">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ambient magnetic field vector (Tesla, NED frame), needed by the
         Magnetometer system plugin. Without this the plugin has nothing
         real to simulate a compass reading against, which surfaces as
         "Strong magnetic interference" / "no heading reference" in PX4's
         preflight checks even though the plugin itself loads fine.
         Standard Gazebo default-world value, not location-specific. -->
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Geographic anchor for NavSat (GPS) and Magnetometer sensors.
         Without this block both sensors fail to update at all
         ("Spherical coordinates not set" in gz_sim.log) and PX4 can
         never get a GPS fix or heading reference. Coordinates: UCT
         upper campus, Cape Town. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.9575</latitude_deg>
      <longitude_deg>18.4607</longitude_deg>
      <elevation>100</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

    <!-- NOTE: PosePublisher does NOT go here. Gazebo Harmonic 8.14.0's
         PosePublisher plugin must be attached inside the specific
         <model> whose pose you want published, not at world level —
         confirmed against /usr/share/gz/gz-sim8/worlds/pose_publisher.sdf
         on the target system. World-level attachment fails with
         "PosePublisher plugin should be attached to a model entity".
         Since the x500 UAV model isn't defined in this world file (it's
         spawned at runtime from PX4's own model.sdf), the plugin is
         added there instead — see apply_x500_patch.sh. Ground robots
         added in Phase 2 will need the same treatment: the plugin goes
         in THEIR model.sdf, not here. -->


    <!-- PX4 x500 needs a magnetometer + a world-level NavSat/Imu setup;
         those systems above cover it. If PX4 complains about a missing
         sensor system when you first launch, check the world file that
         ships with PX4-Autopilot's default gz_x500 target and diff it
         against this one — occasional Harmonic point-release changes
         add/rename a system plugin. -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.42 0.22 1</ambient>
            <diffuse>0.32 0.48 0.24 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple, dependency-free "rubble"/waypoint markers so the field
         isn't visually empty and so you have fixed reference points for
         eyeballing robot trajectories. Positioned to roughly bound the
         15-150m operating radius already validated in the soak test.
         Replace/extend with real Fuel props once the base world loads. -->
    <model name="marker_rock_a">
      <static>true</static>
      <pose>15 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material>
            <ambient>0.4 0.38 0.35 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_rock_b">
      <static>true</static>
      <pose>0 30 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material>
            <ambient>0.4 0.38 0.35 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_post_150">
      <static>true</static>
      <pose>150 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.1</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.1</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.6 0.1 0.1 1</ambient>
            <diffuse>0.7 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Robots ──────────────────────────────────────────────────────
         Included at world load (plain, non-merge includes) rather than
         spawned at runtime: Harmonic's SceneBroadcaster fails to add
         merge-included EntityFactory spawns to the scene graph, so a GUI
         attached to the server never receives their visuals (physics and
         pose/info work — only rendering silently breaks). Load-time
         includes go through the normal path and render correctly.

         Requires GZ_SIM_RESOURCE_PATH to contain the PX4 and TurtleBot3
         model dirs at server launch — start_full_stack.sh exports it.
         The names below are what channel_bridge.py / gazebo_viz.py /
         auto_patrol.py key on.                                      -->
    <include>
      <name>sar_uav</name>
      <pose>0 0 40 0 0 0</pose>
      <uri>model://x500_base</uri>
      <static>true</static>  <!-- holds 40m without PX4 SITL (stopgap) -->
    </include>

    <include>
      <name>sar_ground_alpha</name>
      <pose>15 0 0.1 0 0 0</pose>
      <uri>model://turtlebot3_burger</uri>
    </include>

    <include>
      <name>sar_ground_bravo</name>
      <pose>30 0 0.1 0 0 0</pose>
      <uri>model://turtlebot3_burger</uri>
    </include>

  </world>
</sdf>
