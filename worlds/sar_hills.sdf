<?xml version="1.0" ?>
<!-- sar_hills.sdf — AUTO-GENERATED by make_hills_world.py.
     Hill geometry is defined in terrain_hills.py, which is also
     imported by channel_bridge.py for the ITU-R P.526 knife-edge
     diffraction loss, so the radio and the visuals share one
     source of truth. Edit terrain_hills.py and re-run the
     generator; do not hand-edit this file. -->
<sdf version="1.9">
  <world name="sar_hills">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ambient magnetic field vector (Tesla, NED frame), needed by the
         Magnetometer system plugin. Without this the plugin has nothing
         real to simulate a compass reading against, which surfaces as
         "Strong magnetic interference" / "no heading reference" in PX4's
         preflight checks even though the plugin itself loads fine.
         Standard Gazebo default-world value, not location-specific. -->
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Geographic anchor for NavSat (GPS) and Magnetometer sensors.
         Without this block both sensors fail to update at all
         ("Spherical coordinates not set" in gz_sim.log) and PX4 can
         never get a GPS fix or heading reference. Coordinates: UCT
         upper campus, Cape Town. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.9575</latitude_deg>
      <longitude_deg>18.4607</longitude_deg>
      <elevation>100</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

    <!-- NOTE: PosePublisher does NOT go here. Gazebo Harmonic 8.14.0's
         PosePublisher plugin must be attached inside the specific
         <model> whose pose you want published, not at world level —
         confirmed against /usr/share/gz/gz-sim8/worlds/pose_publisher.sdf
         on the target system. World-level attachment fails with
         "PosePublisher plugin should be attached to a model entity".
         Since the x500 UAV model isn't defined in this world file (it's
         spawned at runtime from PX4's own model.sdf), the plugin is
         added there instead — see apply_x500_patch.sh. Ground robots
         added in Phase 2 will need the same treatment: the plugin goes
         in THEIR model.sdf, not here. -->


    <!-- PX4 x500 needs a magnetometer + a world-level NavSat/Imu setup;
         those systems above cover it. If PX4 complains about a missing
         sensor system when you first launch, check the world file that
         ships with PX4-Autopilot's default gz_x500 target and diff it
         against this one — occasional Harmonic point-release changes
         add/rename a system plugin. -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.42 0.22 1</ambient>
            <diffuse>0.32 0.48 0.24 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Hills (terrain shadowing) ─────────────────────── -->
    <model name="hill_0">
      <static>true</static>
      <pose>45 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>20 20 18</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>20 20 18</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_1">
      <static>true</static>
      <pose>55 35 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>24 24 16</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>24 24 16</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_2">
      <static>true</static>
      <pose>-50 30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>24 24 15</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>24 24 15</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_3">
      <static>true</static>
      <pose>35 -55 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>26 26 20</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>26 26 20</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_4">
      <static>true</static>
      <pose>-45 -45 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>25 25 16</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>25 25 16</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_5">
      <static>true</static>
      <pose>0 70 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>30 30 22</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>30 30 22</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_6">
      <static>true</static>
      <pose>0 -68 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>27 27 14</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>27 27 14</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="hill_7">
      <static>true</static>
      <pose>-72 10 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><ellipsoid><radii>24 24 17</radii></ellipsoid></geometry>
        </collision>
        <visual name="visual">
          <geometry><ellipsoid><radii>24 24 17</radii></ellipsoid></geometry>
          <material><ambient>0.34 0.40 0.24 1</ambient><diffuse>0.40 0.47 0.28 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="victim">
      <static>true</static>
      <pose>70.0 6.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>310.0</temperature>
          </plugin>
          <material><ambient>0.9 0.5 0.4 1</ambient><diffuse>0.95 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robots. UAV hovers over the central flat; the burgers spawn there
         and drive out between the hills. Motion is cmd_vel/set_pose. -->
    <include>
      <name>sar_uav</name>
      <pose>0 0 40 0 0 0</pose>
      <uri>model://x500_base</uri>
      <static>true</static>
    </include>

    <include>
      <name>sar_ground_alpha</name>
      <pose>15 0 0 0 0 0</pose>
      <uri>model://sar_burger</uri>
    </include>

    <include>
      <name>sar_ground_bravo</name>
      <pose>-15 0 0 0 0 0</pose>
      <uri>model://sar_burger</uri>
    </include>

  </world>
</sdf>
